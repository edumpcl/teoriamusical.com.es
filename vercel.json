{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "crons": [
    { "path": "/api/clasificacion/", "schedule": "0 5 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)/fichas/(.*).pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/agenda-conciertos-bandas-orquestas/conciertos.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/pruebas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/panel/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/juegos/auditivos/eco/",
      "destination": "/juegos/auditivos/memoriza/",
      "permanent": true
    },
    {
      "source": "/juegos/auditivos/eco/juego/",
      "destination": "/juegos/auditivos/memoriza/juego/",
      "permanent": true
    },
    {
      "source": "/test-tecnico-de-laboratorio/",
      "destination": "/tecnico-especialista-en-laboratorio/",
      "permanent": true
    },
    {
      "source": "/teoria-musical/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/uploads/:path*",
      "destination": "/assets/img/:path*",
      "permanent": true
    },
    {
      "source": "/blog/historia/himno-a-san-juan/",
      "destination": "/blog/himno-a-san-juan/",
      "permanent": true
