# ----- Editor / OS -----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ----- Vercel -----
.vercel/

# ----- Python (generador) -----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ----- Artefactos intermedios del generador -----
# wp_parsed.json SÍ se versiona: permite regenerar el sitio con
# `python3 tools/build.py` sin necesitar el XML original.
tools/raw/
# Fuentes .ttf regeneradas desde los .woff2 de assets/fonts/ por
# gen_og_premium_ritmo.py — no hace falta versionarlas.
tools/*.ttf

# ----- Node / Playwright -----
node_modules/
package.json
package-lock.json
audit-mobile.js
.playwright-mcp/

# ----- Claude Code (configuración local) -----
.claude/settings.local.json

# ----- Logs / temporales -----
*.log
.cache/

# ----- Credenciales de las APIs de Google (NUNCA versionar) -----
# credentials.json = cliente OAuth de escritorio, compartido por GSC y AdSense.
# gsc-service-account.json = cuenta de servicio, sirve para GSC y GA4.
# *-token.json = tokens de usuario con refresh_token (acceso a la cuenta).
tools/credentials.json
tools/token.json
tools/adsense-token.json
tools/gsc-service-account.json
